{
  "service_name": "TN Nativity Certificate",
  "service_id": "tn_nativity_certificate",
  "version": "1.0.0",
  "description": "Tamil Nadu Nativity Certificate",
  "url_patterns": [
    "*.tn.gov.in.*nativity",
    "csccloud.in.*nativity"
  ],
  "field_mappings": {
    "applicant_name": {
      "form_field_id": "applicant_name",
      "input_type": "text",
      "label_hint": "Applicant Name",
      "required": true
    },
    "father_name": {
      "form_field_id": "father_name",
      "input_type": "text",
      "label_hint": "Father's Name",
      "required": true
    },
    "dob": {
      "form_field_id": "date_of_birth",
      "input_type": "date",
      "label_hint": "Date of Birth",
      "required": true
    },
    "address_line1": {
      "form_field_id": "address",
      "input_type": "textarea",
      "label_hint": "Address",
      "required": true
    },
    "district": {
      "form_field_id": "district",
      "input_type": "select",
      "label_hint": "District",
      "required": true
    },
    "taluk": {
      "form_field_id": "taluk",
      "input_type": "select",
      "label_hint": "Taluk",
      "required": true
    },
    "pincode": {
      "form_field_id": "pincode",
      "input_type": "text",
      "label_hint": "Pin Code",
      "required": true
    },
    "mobile": {
      "form_field_id": "mobile_no",
      "input_type": "tel",
      "label_hint": "Mobile Number",
      "required": true
    }
  },
  "upload_fields": ["address_proof", "identity_proof"],
  "conditional_logic": {}
}
