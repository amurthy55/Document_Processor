{
  "service_name": "TN Income Certificate",
  "service_id": "tn_income_certificate",
  "version": "1.0.0",
  "description": "Tamil Nadu Income Certificate",
  "url_patterns": [
    "*.tn.gov.in.*income.*certificate",
    "csccloud.in.*income"
  ],
  "field_mappings": {
    "applicant_name": {
      "form_field_id": "applicant_name",
      "input_type": "text",
      "label_hint": "Applicant Name",
      "required": true
    },
    "father_name": {
      "form_field_id": "father_name",
      "input_type": "text",
      "label_hint": "Father's Name",
      "required": true
    },
    "dob": {
      "form_field_id": "date_of_birth",
      "input_type": "date",
      "label_hint": "Date of Birth",
      "required": true
    },
    "gender": {
      "form_field_id": "gender",
      "input_type": "select",
      "label_hint": "Gender",
      "options": ["Male", "Female", "Others"],
      "required": true
    },
    "address_line1": {
      "form_field_id": "address",
      "input_type": "textarea",
      "label_hint": "Address",
      "required": true
    },
    "district": {
      "form_field_id": "district",
      "input_type": "select",
      "label_hint": "District",
      "required": true
    },
    "taluk": {
      "form_field_id": "taluk",
      "input_type": "select",
      "label_hint": "Taluk",
      "required": true
    },
    "pincode": {
      "form_field_id": "pincode",
      "input_type": "text",
      "label_hint": "Pin Code",
      "required": true
    },
    "income": {
      "form_field_id": "annual_income",
      "input_type": "text",
      "label_hint": "Annual Income",
      "required": true
    },
    "mobile": {
      "form_field_id": "mobile_no",
      "input_type": "tel",
      "label_hint": "Mobile Number",
      "required": true
    },
    "email": {
      "form_field_id": "email_id",
      "input_type": "email",
      "label_hint": "Email ID",
      "required": false
    }
  },
  "upload_fields": [
    "income_proof",
    "address_proof",
    "identity_proof"
  ],
  "conditional_logic": {
    "income_field_required": "if document_type == 'income_certificate'"
  }
}
