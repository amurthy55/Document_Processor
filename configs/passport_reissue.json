{
  "service_name": "Passport Reissue",
  "service_id": "passport_reissue",
  "version": "1.0.0",
  "description": "India Passport Reissue Application",
  "url_patterns": [
    "passportindia.gov.in",
    "cgionline.gov.in"
  ],
  "field_mappings": {
    "applicant_name": {
      "form_field_id": "applicant_name",
      "input_type": "text",
      "label_hint": "Full Name",
      "required": true
    },
    "father_name": {
      "form_field_id": "father_name",
      "input_type": "text",
      "label_hint": "Father's Name",
      "required": true
    },
    "mother_name": {
      "form_field_id": "mother_name",
      "input_type": "text",
      "label_hint": "Mother's Name",
      "required": true
    },
    "dob": {
      "form_field_id": "date_of_birth",
      "input_type": "date",
      "label_hint": "Date of Birth",
      "required": true
    },
    "gender": {
      "form_field_id": "gender",
      "input_type": "select",
      "label_hint": "Gender",
      "required": true
    },
    "address_line1": {
      "form_field_id": "address",
      "input_type": "textarea",
      "label_hint": "Address",
      "required": true
    },
    "mobile": {
      "form_field_id": "mobile_no",
      "input_type": "tel",
      "label_hint": "Mobile Number",
      "required": true
    },
    "email": {
      "form_field_id": "email",
      "input_type": "email",
      "label_hint": "Email",
      "required": true
    }
  },
  "upload_fields": ["old_passport", "address_proof", "identity_proof"],
  "conditional_logic": {}
}
